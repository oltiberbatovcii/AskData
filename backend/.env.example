# Copy this file to `.env` and change values as needed.
# Every value here is optional: the defaults in app/core/config.py are used if missing.
# Keep comments on their own line (Docker's env_file does not support inline comments).

# --- Database ---
# Relative paths are resolved from the backend/ folder.
DB_PATH=data/chinook.sqlite
ROW_LIMIT=100
QUERY_TIMEOUT_SECONDS=5

# --- LLM ---
# One of: ollama | anthropic | openai
LLM_PROVIDER=ollama
# Use llama3.2 on weaker machines
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434

# --- API ---
# Frontend URL allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
